---
interface Props {
  src: string | undefined | null;
  alt: string;
  class?: string;
  imageClass?: string;
  caption?: string;
}

const { src, alt, class: className = "", imageClass = "" } = Astro.props;
---

<div class="image-viewer" data-image-viewer>
  <button
    type="button"
    class={`image-viewer-trigger block w-full cursor-pointer border-0 bg-transparent p-0 ${className}`}
    aria-label={`放大檢視 ${alt}`}
  >
    <img
      src={src}
      alt={alt}
      class={`block h-auto w-full object-cover transition-transform duration-300 hover:scale-[1.02] ${imageClass}`}
    />
  </button>

  <div
    class="image-viewer-overlay"
    aria-hidden="true"
  >
    <button
      type="button"
      class="image-viewer-close"
      aria-label="關閉圖片檢視"
    >
      ×
    </button>

    <div class="image-viewer-stage">
      <img src={src} alt={alt} class="image-viewer-image" />
    </div>
  </div>
</div>

<style>
  .image-viewer-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.9);
    z-index: 99999;
    overflow: hidden;
    touch-action: none;
  }

  .image-viewer-overlay.is-open {
    display: flex;
  }

  .image-viewer-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }

  .image-viewer-stage:active {
    cursor: grabbing;
  }

  .image-viewer-image {
    display: block;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    user-select: none;
    pointer-events: none;
    transform: translate3d(var(--pan-x, 0px), var(--pan-y, 0px), 0) scale(var(--zoom, 1));
    transform-origin: center center;
    transition: none;
    will-change: transform;
  }

  .image-viewer-image.is-bouncing {
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .image-viewer-close {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 9999px;
    background: rgba(0, 0, 0, 0.45);
    color: white;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .image-viewer-close:hover {
    background: rgba(0, 0, 0, 0.7);
  }
</style>

<script>
  function clamp(value: number, min: number, max: number) {
    return Math.min(Math.max(value, min), max);
  }

  function getMidpoint(a: Touch, b: Touch) {
    return {
      x: (a.clientX + b.clientX) / 2,
      y: (a.clientY + b.clientY) / 2,
    };
  }

  function getDistance(a: Touch, b: Touch) {
    return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
  }

  function initImageViewer() {
    const viewers = document.querySelectorAll<HTMLElement>("[data-image-viewer]");

    viewers.forEach((viewer) => {
      if (viewer.dataset.initialized === "true") return;
      viewer.dataset.initialized = "true";

      const trigger = viewer.querySelector<HTMLButtonElement>(".image-viewer-trigger");
      const overlay = viewer.querySelector<HTMLElement>(".image-viewer-overlay");
      const closeButton = viewer.querySelector<HTMLButtonElement>(".image-viewer-close");
      const stage = viewer.querySelector<HTMLElement>(".image-viewer-stage");
      const image = viewer.querySelector<HTMLImageElement>(".image-viewer-image");

      if (!trigger || !overlay || !closeButton || !stage || !image) return;

      document.body.appendChild(overlay);

      let zoom = 1;
      let panX = 0;
      let panY = 0;
      let dragStart: { x: number; y: number; panX: number; panY: number } | null = null;
      let pinchStart: {
        distance: number;
        zoom: number;
        panX: number;
        panY: number;
        midpoint: { x: number; y: number };
      } | null = null;
      let activeTouchCount = 0;
      let bounceTimeout: number | undefined;

      const getPanBounds = () => {
        const width = image.clientWidth * zoom;
        const height = image.clientHeight * zoom;

        return {
          x: Math.max(0, (width - stage.clientWidth) / 2),
          y: Math.max(0, (height - stage.clientHeight) / 2),
        };
      };

      const getOvershoot = () => Math.min(stage.clientWidth, stage.clientHeight) * 0.1;

      const applyResistance = (value: number, bound: number) => {
        if (bound === 0) return 0;
        if (value > bound) return bound + Math.min((value - bound) * 0.22, getOvershoot());
        if (value < -bound) return -bound - Math.min((-value - bound) * 0.22, getOvershoot());
        return value;
      };

      const applyTransform = () => {
        image.style.setProperty("--zoom", zoom.toFixed(3));
        image.style.setProperty("--pan-x", `${panX}px`);
        image.style.setProperty("--pan-y", `${panY}px`);
      };

      const cancelBounce = () => {
        if (bounceTimeout !== undefined) {
          window.clearTimeout(bounceTimeout);
          bounceTimeout = undefined;
        }
        image.classList.remove("is-bouncing");
      };

      const settlePan = () => {
        const bounds = getPanBounds();
        const nextPanX = clamp(panX, -bounds.x, bounds.x);
        const nextPanY = clamp(panY, -bounds.y, bounds.y);

        if (nextPanX === panX && nextPanY === panY) return;

        cancelBounce();
        image.classList.add("is-bouncing");
        panX = nextPanX;
        panY = nextPanY;
        applyTransform();
        bounceTimeout = window.setTimeout(() => {
          image.classList.remove("is-bouncing");
          bounceTimeout = undefined;
        }, 320);
      };

      const resetView = () => {
        cancelBounce();
        zoom = 1;
        panX = 0;
        panY = 0;
        applyTransform();
      };

      const openViewer = () => {
        document.body.appendChild(overlay);
        overlay.classList.add("is-open");
        overlay.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        resetView();
      };

      const closeViewer = () => {
        overlay.classList.remove("is-open");
        overlay.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
        resetView();
      };

      trigger.addEventListener("click", openViewer);
      closeButton.addEventListener("click", closeViewer);

      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          closeViewer();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && overlay.classList.contains("is-open")) {
          closeViewer();
        }
      });

      overlay.addEventListener(
        "wheel",
        (event) => {
          event.preventDefault();
          const factor = event.deltaY < 0 ? 1.12 : 0.88;
          cancelBounce();
          zoom = clamp(zoom * factor, 1, 5);
          if (zoom === 1) {
            panX = 0;
            panY = 0;
          } else {
            settlePan();
          }
          applyTransform();
        },
        { passive: false },
      );

      stage.addEventListener("pointerdown", (event) => {
        if (zoom <= 1 || (event.pointerType === "touch" && activeTouchCount > 1)) return;
        cancelBounce();
        dragStart = { x: event.clientX, y: event.clientY, panX, panY };
        stage.setPointerCapture(event.pointerId);
      });

      stage.addEventListener("pointermove", (event) => {
        if (!dragStart || (event.pointerType === "touch" && activeTouchCount > 1)) return;
        const bounds = getPanBounds();
        const nextPanX = dragStart.panX + (event.clientX - dragStart.x);
        const nextPanY = dragStart.panY + (event.clientY - dragStart.y);
        panX = applyResistance(nextPanX, bounds.x);
        panY = applyResistance(nextPanY, bounds.y);
        applyTransform();
      });

      const endDrag = () => {
        if (!dragStart) return;
        dragStart = null;
        settlePan();
      };

      stage.addEventListener("pointerup", endDrag);
      stage.addEventListener("pointercancel", endDrag);
      stage.addEventListener("lostpointercapture", endDrag);
      window.addEventListener("blur", endDrag);

      overlay.addEventListener(
        "touchstart",
        (event) => {
          activeTouchCount = event.touches.length;
          if (event.touches.length === 2) {
            const [first, second] = [event.touches[0], event.touches[1]];
            dragStart = null;
            pinchStart = {
              distance: getDistance(first, second),
              zoom,
              panX,
              panY,
              midpoint: getMidpoint(first, second),
            };
          }
        },
        { passive: true },
      );

      overlay.addEventListener(
        "touchmove",
        (event) => {
          if (event.touches.length === 2 && pinchStart) {
            event.preventDefault();
            const [first, second] = [event.touches[0], event.touches[1]];
            const distance = getDistance(first, second);
            const ratio = distance / pinchStart.distance;
            const midpoint = getMidpoint(first, second);
            const nextZoom = clamp(pinchStart.zoom * ratio, 1, 5);
            const zoomRatio = nextZoom / pinchStart.zoom;

            cancelBounce();
            panX = pinchStart.panX * zoomRatio + (midpoint.x - pinchStart.midpoint.x);
            panY = pinchStart.panY * zoomRatio + (midpoint.y - pinchStart.midpoint.y);
            zoom = nextZoom;
            if (zoom === 1) {
              panX = 0;
              panY = 0;
            }
            const bounds = getPanBounds();
            panX = applyResistance(panX, bounds.x);
            panY = applyResistance(panY, bounds.y);
            applyTransform();
          }
        },
        { passive: false },
      );

      overlay.addEventListener("touchend", (event) => {
        activeTouchCount = event.touches.length;
        pinchStart = null;
        if (activeTouchCount === 0) settlePan();
      });

      overlay.addEventListener("touchcancel", () => {
        activeTouchCount = 0;
        pinchStart = null;
        dragStart = null;
        settlePan();
      });
    });
  }

  initImageViewer();
  document.addEventListener("astro:after-swap", initImageViewer);
</script>
