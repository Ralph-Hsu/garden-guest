<!--
  背景圖片設定：
  - 亮色模式：請將庭園白天照片放置於 /public/images/backgrounds/garden-day.jpg
  - 暗色模式：請將庭園夜景照片放置於 /public/images/backgrounds/garden-night.jpg
  
  建議圖片規格：1920×1080px 以上，JPG 格式，檔案大小建議 500KB～2MB
-->

<style>
  html::before,
  html::after {
    content: "";
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    z-index: -1;
    transition: opacity 0.5s ease-in-out;
    pointer-events: none;
  }

  /* 亮色模式背景（庭園白天照）
     【請將照片放置於 /public/images/backgrounds/garden-day.jpg】 */
  html::before {
    background-image: var(--page-bg-light, url(/images/backgrounds/garden-day.jpg));
    /* 尚未放置圖片時，顯示暖米色漸層作為備援 */
    background-color: #f5f0ea;
    opacity: 1;
  }

  html.dark::before {
    opacity: 0;
  }

  /* 暗色模式背景（庭園夜景照）
     【請將照片放置於 /public/images/backgrounds/garden-night.jpg】 */
  html::after {
    background-image: var(--page-bg-dark, url(/images/backgrounds/garden-night.jpg));
    /* 尚未放置圖片時，顯示深石褐漸層作為備援 */
    background-color: #1c1917;
    opacity: 0;
  }

  html.dark::after {
    opacity: 1;
  }
</style>
