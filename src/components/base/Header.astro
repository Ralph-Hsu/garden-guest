---
import ThemeSwitcher from "@components/base/ThemeSwitcher.astro";
import { IoSearch } from "react-icons/io5";
import { stripBasePath, withBasePath } from "@lib/url";

const currentPath = stripBasePath(Astro.url.pathname);
const activeLinkClasses = "text-garden-amber dark:text-amber-300 border-b-2 border-garden-amber dark:border-amber-300";
const inactiveLinkClasses = "hover:text-garden-amber dark:hover:text-amber-300";

const normalizePath = (path: string) => {
  if (path === "/") return "/";
  return path.endsWith("/") ? path.slice(0, -1) : path;
};

const isMenuActive = (currentPath: string, itemUrl: string) => {
  const normalizedCurrentPath = normalizePath(currentPath);
  const normalizedItemUrl = normalizePath(itemUrl);

  if (normalizedItemUrl === "/") return normalizedCurrentPath === "/";
  return (
    normalizedCurrentPath === normalizedItemUrl ||
    normalizedCurrentPath.startsWith(`${normalizedItemUrl}/`)
  );
};

const stickyHeader = true;

const menu = [
  {
    name: "首頁",
    url: "/",
  },
  {
    name: "櫻花",
    url: "/cherry",
  },
  {
    name: "睡蓮",
    url: "/lotus",
  },
  {
    name: "盆栽",
    url: "/bonsai",
  },
  {
    name: "花草",
    url: "/flora",
  },
];

const logoUrl = withBasePath("/");
const searchUrl = withBasePath("/search");
---

<header
  transition:persist
  class={`container glass py-2 z-30 mb-4 lg:mt-4 lg:rounded-lg ${stickyHeader && "sticky top-0"}`}
>
  <nav class="relative flex flex-wrap items-center justify-between">
    <!-- Logo -->
    <a
      href={logoUrl}
      class="order-0 font-primary text-xl font-bold text-garden-amber dark:text-amber-300 no-underline mr-4 shrink-0"
      style="opacity:1 !important;"
    >
      中台庭園
    </a>

    <!-- navbar toggler -->
    <input id="nav-toggle" type="checkbox" class="hidden" />
    <label
      for="nav-toggle"
      class="order-2 cursor-pointer flex items-center md:hidden text-txt-p dark:text-darkmode-txt-p lg:order-1"
    >
      <svg id="show-button" class="h-6 fill-current block" viewBox="0 0 20 20">
        <title>Menu Open</title>
        <path d="M0 3h20v2H0V3z m0 6h20v2H0V9z m0 6h20v2H0V0z"></path>
      </svg>
      <svg id="hide-button" class="h-6 fill-current hidden" viewBox="0 0 20 20">
        <title>Menu Close</title>
        <polygon
          points="11 9 22 9 22 11 11 11 11 22 9 22 9 11 -2 11 -2 9 9 9 9 -2 11 -2"
          transform="rotate(45 10 10)"></polygon>
      </svg>
    </label>
    <!-- /navbar toggler -->
    <ul
      id="nav-menu"
      class="text-center lg:text-left order-3 hidden w-full pb-6 md:order-1 md:flex md:w-auto md:space-x-1 md:pb-0 lg:space-x-2"
    >
      {
        menu.map((item) => (
          <li>
            <a
              href={withBasePath(item.url)}
              data-nav-link
              data-nav-url={item.url}
              class={`block px-2 py-2 font-secondary font-semibold text-sm text-txt-p transition dark:text-darkmode-txt-p lg:px-2 lg:py-3 ${
                isMenuActive(currentPath ?? "/", item.url ?? "/")
                  ? activeLinkClasses
                  : inactiveLinkClasses
              }`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="order-1 ml-auto flex items-center md:order-2 lg:ml-0">
      <a
        class="mr-3 inline-block text-xl text-txt-p dark:text-darkmode-txt-p hover:text-garden-amber dark:hover:text-amber-300 transition"
        href={searchUrl}
        aria-label="搜尋"
        style="opacity:1 !important;"
      >
        <IoSearch />
      </a>
      <ThemeSwitcher />
    </div>
  </nav>
</header>

<script>
  const activeLinkClasses = [
    "text-garden-amber",
    "dark:text-amber-300",
    "border-b-2",
    "border-garden-amber",
    "dark:border-amber-300",
  ];
  const inactiveLinkClasses = [
    "hover:text-garden-amber",
    "dark:hover:text-amber-300",
  ];

  const normalizePath = (path: string) => {
    if (path === "/") return "/";
    return path.endsWith("/") ? path.slice(0, -1) : path;
  };

  const stripBasePath = (path: string) => {
    const baseUrl = import.meta.env.BASE_URL || "/";
    const basePrefix = baseUrl === "/" ? "" : baseUrl.replace(/\/$/, "");
    if (!basePrefix) return path;
    if (path === basePrefix) return "/";
    return path.startsWith(`${basePrefix}/`) ? path.slice(basePrefix.length) : path;
  };

  const isMenuActive = (currentPath: string, itemUrl: string) => {
    const normalizedCurrentPath = normalizePath(currentPath);
    const normalizedItemUrl = normalizePath(itemUrl);

    if (normalizedItemUrl === "/") return normalizedCurrentPath === "/";
    return (
      normalizedCurrentPath === normalizedItemUrl ||
      normalizedCurrentPath.startsWith(`${normalizedItemUrl}/`)
    );
  };

  const closeMobileMenu = () => {
    const navToggle = document.getElementById("nav-toggle");
    if (navToggle instanceof HTMLInputElement) {
      navToggle.checked = false;
    }
  };

  const updateActiveMenuItem = () => {
    const currentPath = stripBasePath(window.location.pathname);
    const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");

    links.forEach((link) => {
      const itemUrl = link.dataset.navUrl || "/";
      const isActive = isMenuActive(currentPath, itemUrl);

      link.classList.remove(...activeLinkClasses, ...inactiveLinkClasses);
      link.classList.add(...(isActive ? activeLinkClasses : inactiveLinkClasses));
    });
  };

  document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  updateActiveMenuItem();
  document.addEventListener("astro:page-load", () => {
    closeMobileMenu();
    updateActiveMenuItem();
  });
</script>
