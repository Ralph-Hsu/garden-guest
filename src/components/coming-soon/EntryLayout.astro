---
import BaseLayout from "@components/base/BaseLayout.astro";
import Button from "@components/common/Button.astro";
import { withBasePath } from "@lib/url";

const constructionGifUrl = withBasePath("/images/coming-soon.gif");
---

<BaseLayout title="開發中">
  <section class="section-sm text-center">
    <div class="container">
      <div class="row justify-center">
        <div class="glass rounded-lg p-4 sm:col-10 md:col-8 lg:col-6 intersect:animate-fadeUp opacity-0">
          <h1 class="h2 mb-4">頁面開發中</h1>
          <p class="mb-8">
            此頁面正在開發中，敬請期待。
          </p>
          <img
            class="mb-8 w-full rounded-lg"
            src={constructionGifUrl}
            alt="施工中"
          />
          <Button link="/" label="返回首頁" hoverInvert />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
