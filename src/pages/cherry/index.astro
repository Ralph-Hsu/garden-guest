---
import BaseLayout from "@components/base/BaseLayout.astro";
import CherryMap from "@components/cherry/CherryMap.astro";
import CherryCard from "@components/cherry/Card.astro";
import { getCollection } from "astro:content";

const entries = (await getCollection("cherry", ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="櫻花"
  description="探索中台庭園的七大櫻花品種，從早春到暮春的絢爛花季。"
  backgroundImage="/images/cherry/hero.jpg"
>

  <!-- Hero -->
  <section class="relative min-h-[50vh] flex items-center justify-center overflow-hidden -mt-4 mb-0">
    <div class="relative z-10 text-center px-4">
      <div class="glass rounded-3xl px-10 py-8 inline-block intersect:animate-scale opacity-0">
        <p class="font-secondary text-sm tracking-[0.3em] text-rose-200 uppercase mb-2">Cherry Blossoms</p>
        <h1 class="text-white mb-2">中台庭園・櫻花</h1>
        <p class="font-secondary text-stone-200 text-sm">七大品種・從寒冬到暮春的花季接力</p>
      </div>
    </div>
  </section>

  <!-- GSAP 滾動故事地圖 -->
  <CherryMap entries={entries} />

  <!-- 品種列表 -->
  <section class="section container">
    <div class="text-center mb-8 intersect:animate-fadeUp opacity-0">
      <h2 class="text-txt-p dark:text-darkmode-txt-p mb-2">七大品種圖鑑</h2>
      <p class="font-secondary text-txt-light dark:text-darkmode-txt-light text-sm">
        點擊各品種了解詳細介紹
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {entries.map((entry) => <CherryCard entry={entry} />)}
    </div>

    <!-- 族譜與時序表入口 -->
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
      <a
        href="/cherry/family-tree"
        class="glass rounded-2xl p-6 text-center hover:-translate-y-1 transition-all duration-300 intersect:animate-fadeUp opacity-0"
      >
        <div class="text-3xl mb-2">🌳</div>
        <h4 class="text-garden-amber dark:text-amber-300 mb-1" style="opacity:1">櫻花族譜</h4>
        <p class="font-secondary text-xs text-txt-light dark:text-darkmode-txt-light" style="opacity:1">
          品種親緣關係圖
        </p>
      </a>
      <a
        href="/cherry/timeline"
        class="glass rounded-2xl p-6 text-center hover:-translate-y-1 transition-all duration-300 intersect:animate-fadeUp opacity-0"
      >
        <div class="text-3xl mb-2">📅</div>
        <h4 class="text-garden-amber dark:text-amber-300 mb-1" style="opacity:1">花期時序表</h4>
        <p class="font-secondary text-xs text-txt-light dark:text-darkmode-txt-light" style="opacity:1">
          歷年實際開花紀錄
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
