---
import BaseLayout from "@components/base/BaseLayout.astro";
import { getCollection } from "astro:content";

const POSTS_PER_PAGE = 9;

const allPosts = (await getCollection("news", ({ data }) => !data.draft))
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));

const pageCount = Math.ceil(allPosts.length / POSTS_PER_PAGE);

export async function getStaticPaths() {
  const pageCount = Math.ceil((await getCollection("news", ({ data }) => !data.draft)).length / 9);
  const pages = [];

  for (let page = 2; page <= pageCount; page += 1) {
    pages.push({
      params: {
        slug: page.toString(),
      },
    });
  }

  return pages;
}

const { slug } = Astro.params;
const currentPageIndex = slug && !isNaN(Number(slug)) ? Number(slug) : 1;
const indexOfLastPost = currentPageIndex * POSTS_PER_PAGE;
const indexOfFirstPost = indexOfLastPost - POSTS_PER_PAGE;
const posts = allPosts.slice(indexOfFirstPost, indexOfLastPost);
const allCategories = [...new Set(allPosts.flatMap((p) => p.data.categories ?? []))];
---

<BaseLayout title={`最新花況 - 第 ${currentPageIndex} 頁`} description="中台庭園最新花況更新、活動公告與園區消息。">
  <section class="relative min-h-[40vh] flex items-center justify-center overflow-hidden -mt-4 mb-0">
    <div class="absolute inset-0 bg-gradient-to-b from-garden-amber/50 to-stone-900/60" />
    <div class="relative z-10 text-center px-4">
      <div class="glass rounded-3xl px-10 py-8 inline-block intersect:animate-scale opacity-0">
        <p class="font-secondary text-sm tracking-[0.3em] text-amber-200 uppercase mb-2">Garden Updates</p>
        <h1 class="text-white mb-2">最新花況</h1>
        <p class="font-secondary text-stone-200 text-sm">即時花況・活動公告・園區消息</p>
      </div>
    </div>
  </section>

  <section class="section container">
    {allCategories.length > 0 && (
      <div class="flex flex-wrap gap-2 justify-center mb-8 intersect:animate-fadeDown opacity-0">
        <a href="/news" class="font-secondary text-sm px-4 py-1.5 rounded-full glass text-txt-p dark:text-darkmode-txt-p hover:text-garden-amber dark:hover:text-amber-300 transition">
          全部
        </a>
        {allCategories.map((cat) => (
          <a
            href={`/news?category=${encodeURIComponent(cat)}`}
            class="font-secondary text-sm px-4 py-1.5 rounded-full glass text-txt-p dark:text-darkmode-txt-p hover:text-garden-amber dark:hover:text-amber-300 transition"
            style="opacity:1"
          >
            {cat}
          </a>
        ))}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {posts.map((post) => (
        <a
          href={`/news/${post.id}`}
          class="group glass rounded-2xl overflow-hidden hover:-translate-y-1 transition-all duration-300 intersect:animate-fadeUp opacity-0"
        >
          <div
            class="relative w-full h-48 bg-stone-200 dark:bg-stone-700 bg-cover bg-center overflow-hidden"
            style={post.data.image ? `background-image: url('${post.data.image}');` : ""}
          >
            {!post.data.image && <div class="absolute inset-0 flex items-center justify-center text-4xl">🌸</div>}
            {post.data.categories && post.data.categories[0] && (
              <div class="absolute top-3 left-3">
                <span class="bg-garden-amber/90 text-white text-xs font-secondary px-2 py-1 rounded-full">
                  {post.data.categories[0]}
                </span>
              </div>
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-stone-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          </div>

          <div class="p-5">
            {post.data.date && (
              <p class="font-secondary text-xs text-txt-light dark:text-darkmode-txt-light mb-2">
                {post.data.date.toLocaleDateString("zh-TW", { year: "numeric", month: "long", day: "numeric" })}
              </p>
            )}
            <h4 class="text-txt-p dark:text-darkmode-txt-p mb-2 line-clamp-2 group-hover:text-garden-amber dark:group-hover:text-amber-300 transition-colors" style="opacity:1">
              {post.data.title}
            </h4>
            {post.data.description && (
              <p class="font-secondary text-sm text-txt-light dark:text-darkmode-txt-light line-clamp-2" style="opacity:1">
                {post.data.description}
              </p>
            )}
            {post.data.tags && post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-1 mt-3">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-[10px] font-secondary text-garden-amber dark:text-amber-300 bg-amber-50 dark:bg-amber-900/20 px-2 py-0.5 rounded">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      ))}
    </div>

    {pageCount > 1 && (
      <div class="flex justify-center gap-2 mt-10 intersect:animate-fadeUp opacity-0">
        {Array.from({ length: pageCount }, (_, i) => (
          <a
            href={i === 0 ? "/news" : `/news/page/${i + 1}`}
            class={`font-secondary text-sm w-9 h-9 flex items-center justify-center rounded-full transition ${
              i + 1 === currentPageIndex
                ? "bg-garden-amber text-white"
                : "glass text-txt-p dark:text-darkmode-txt-p hover:text-garden-amber dark:hover:text-amber-300"
            }`}
            style="opacity:1"
          >
            {i + 1}
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
