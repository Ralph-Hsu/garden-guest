---
import BaseLayout from "@components/base/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("bonsai", ({ data }) => !data.draft);
  return entries
    .filter((e) => !e.id.endsWith("-index"))
    .map((entry) => ({
      params: { entry: entry.id },
      props: { entry },
    }));
}

type Props = { entry: CollectionEntry<"bonsai"> };
const { entry } = Astro.props;
const { title, latinName, category, image, specimens, description } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description}>
  <!-- Hero -->
  <section class="relative min-h-[55vh] flex items-end justify-start overflow-hidden -mt-4 mb-0">
    <div
      class="absolute inset-0 bg-cover bg-center bg-emerald-900"
      style={image ? `background-image: url('${image}');` : ""}
    />
    {!image && (
      <div class="absolute inset-0 flex items-center justify-center text-8xl">🌿</div>
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-stone-900/70 via-stone-900/20 to-transparent" />

    <div class="relative z-10 p-6 md:p-10 max-w-2xl">
      <a href="/bonsai" class="font-secondary text-xs text-stone-300 hover:text-white mb-4 inline-block transition" style="opacity:1">
        ← 回到盆栽總覽
      </a>
      <h1 class="text-white mb-1" style="text-shadow: 0 2px 12px rgba(0,0,0,0.5);">{title}</h1>
      {latinName && (
        <p class="font-secondary italic text-stone-300 text-sm mb-3" style="opacity:1">{latinName}</p>
      )}
      {category && (
        <span class="bg-emerald-700/80 text-white text-xs font-secondary px-3 py-1 rounded-full backdrop-blur-sm">
          {category}
        </span>
      )}
    </div>
  </section>

  <section class="section container">
    <div class="max-w-4xl mx-auto">
      <!-- 品種介紹 -->
      <div class="glass rounded-2xl p-6 md:p-10 mb-8 prose prose-stone dark:prose-invert max-w-none intersect:animate-fadeUp opacity-0">
        <Content />
      </div>

      <!-- 分盆展示 (Swiper Carousel) -->
      {specimens && specimens.length > 0 && (
        <div class="mb-8 intersect:animate-fadeUp opacity-0">
          <h3 class="text-txt-p dark:text-darkmode-txt-p mb-4">園區展示盆栽</h3>
          <p class="font-secondary text-xs text-txt-light dark:text-darkmode-txt-light mb-4" style="opacity:1">
            以下為中台庭園實際展示的 {title} 個體，每一盆都有其獨特的樹形與歷史。
          </p>

          <!-- Swiper -->
          <div class="swiper bonsai-swiper">
            <div class="swiper-wrapper">
              {specimens.map((specimen) => (
                <div class="swiper-slide">
                  <div class="glass rounded-2xl overflow-hidden">
                    <!-- 分盆照片
                         【照片路徑：{specimen.image}】 -->
                    <div
                      class="w-full h-64 bg-stone-200 dark:bg-stone-700 bg-cover bg-center relative"
                      style={`background-image: url('${specimen.image}');`}
                    >
                      <div class="absolute inset-0 flex items-center justify-center opacity-30">
                        <span class="text-4xl">🌿</span>
                      </div>
                    </div>
                    <div class="p-4">
                      <h4 class="text-txt-p dark:text-darkmode-txt-p text-base mb-1" style="opacity:1">
                        {specimen.label}
                      </h4>
                      {specimen.note && (
                        <p class="font-secondary text-sm text-txt-light dark:text-darkmode-txt-light" style="opacity:1">
                          {specimen.note}
                        </p>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <!-- Swiper 控制 -->
            <div class="swiper-pagination mt-4"></div>
            <div class="swiper-button-prev"></div>
            <div class="swiper-button-next"></div>
          </div>
        </div>
      )}

      <a href="/bonsai" class="inline-block font-secondary text-sm text-garden-amber dark:text-amber-300 hover:opacity-70 transition intersect:animate-fadeUp opacity-0" style="opacity:0">
        ← 回到盆栽總覽
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import Swiper from "swiper";
  import { Navigation, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/navigation";
  import "swiper/css/pagination";

  function initBonsaiSwiper() {
    new Swiper(".bonsai-swiper", {
      modules: [Navigation, Pagination],
      slidesPerView: 1,
      spaceBetween: 16,
      breakpoints: {
        640: { slidesPerView: 2 },
        1024: { slidesPerView: 3 },
      },
      pagination: { el: ".swiper-pagination", clickable: true },
      navigation: {
        prevEl: ".swiper-button-prev",
        nextEl: ".swiper-button-next",
      },
    });
  }

  initBonsaiSwiper();
  document.addEventListener("astro:after-swap", initBonsaiSwiper);
</script>

<style>
  .swiper-button-prev,
  .swiper-button-next {
    color: #92400e;
  }
  .swiper-pagination-bullet-active {
    background-color: #92400e;
  }
</style>
